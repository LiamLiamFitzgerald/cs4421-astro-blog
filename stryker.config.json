{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "npx vitest run --bail=1"
  },
  "mutate": [
    "src/lib/core/**/*.ts",
    "src/lib/games/**/*.ts",
    "src/lib/observability/**/*.ts",
    "!src/lib/**/*.test.ts",
    "!src/lib/**/test-helpers.ts"
  ],
  "coverageAnalysis": "off",
  "concurrency": 4,
  "timeoutMS": 60000,
  "reporters": [
    "clear-text",
    "progress",
    "html"
  ],
  "htmlReporter": {
    "fileName": "reports/mutation/index.html"
  },
  "thresholds": {
    "high": 90,
    "low": 75,
    "break": 75
  },
  "ignorePatterns": [
    "dist",
    ".astro",
    "cdk",
    "reports",
    ".stryker-tmp"
  ]
}

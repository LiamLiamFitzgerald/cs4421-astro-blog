---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const repo = 'https://github.com/LiamLiamFitzgerald/cs4421-astro-blog';
const pillars = [
	{
		title: 'Event-sourced core',
		body: 'Every action is stored as an event. Scores, awards and the winner are replayed from the log, never stored.',
		link: { href: `${repo}/blob/develop/docs/adr/ADR-003-event-sourced-game-core.md`, label: 'ADR-003' },
	},
	{
		title: 'Enforced layers',
		body: 'Game rules know nothing about Astro, storage or the browser. CI fails if a dependency points the wrong way.',
		link: { href: `${repo}/blob/develop/docs/adr/ADR-004-layered-architecture-and-dependency-rules.md`, label: 'ADR-004' },
	},
	{
		title: 'Tested at every level',
		body: 'Given/When/Then unit tests, property-based tests, mutation testing and a browser test that plays a game on every pull request.',
		link: { href: `${repo}/blob/develop/docs/adr/ADR-005-verification-strategy.md`, label: 'ADR-005' },
	},
	{
		title: 'Shipped as a container',
		body: 'Server-rendered Astro in a Docker image with a health endpoint and JSON request logs, defined for AWS Fargate in CDK.',
		link: { href: `${repo}/blob/develop/docs/adr/ADR-001-transition-to-ssr-and-containers.md`, label: 'ADR-001' },
	},
	{
		title: 'GitFlow and releases',
		body: 'Feature branches, Conventional Commits checked in CI, protected branches, and versioned releases from release-please.',
		link: { href: `${repo}/blob/develop/docs/adr/ADR-002-gitflow-branching-model.md`, label: 'ADR-002' },
	},
	{
		title: 'Thin UI',
		body: 'The scoreboard is plain TypeScript over the same tested functions, so the interface can change without touching the rules.',
		link: { href: `${repo}/blob/develop/docs/adr/ADR-006-scoreboard-ui-approach.md`, label: 'ADR-006' },
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="home">
			<section class="hero">
				<p class="eyebrow">CS4421 DevOps project</p>
				<h1>Keep score in Catan.<br />Learn how it's built.</h1>
				<p class="lede">
					A scorekeeper for Settlers of Catan, used as a real codebase for practising the engineering
					around software: architecture that defends itself, automated checks, containers and
					repeatable releases.
				</p>
				<div class="cta">
					<a class="button primary" href="/catan">Open the scoreboard</a>
					<a class="button" href={repo} target="_blank" rel="noopener">View the source</a>
				</div>
			</section>

			<section>
				<h2>How it's built</h2>
				<div class="pillars">
					{
						pillars.map((pillar) => (
							<article>
								<h3>{pillar.title}</h3>
								<p>{pillar.body}</p>
								<a href={pillar.link.href} target="_blank" rel="noopener">
									Read {pillar.link.label} →
								</a>
							</article>
						))
					}
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	main.home {
		width: 1040px;
		max-width: calc(100% - 2em);
	}
	.hero {
		max-width: 720px;
		margin: 1em 0 3em;
	}
	.eyebrow {
		margin: 0;
		font-size: 0.75em;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--accent);
	}
	.hero h1 {
		font-size: 2.6em;
		line-height: 1.15;
		margin: 0.2em 0 0.4em;
	}
	.lede {
		color: rgb(var(--gray));
	}
	.cta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.7em;
		margin-top: 1.4em;
	}
	.button {
		display: inline-block;
		padding: 0.5em 1.1em;
		border-radius: 8px;
		border: 1px solid rgb(var(--gray-light));
		background: #fff;
		color: rgb(var(--gray-dark));
		text-decoration: none;
		font-size: 0.9em;
	}
	.button.primary {
		background: var(--accent);
		border-color: var(--accent);
		color: #fff;
	}
	.button:hover {
		border-color: var(--accent);
	}
	.pillars {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
		gap: 1em;
	}
	.pillars article {
		background: #fff;
		border-radius: 12px;
		padding: 1em 1.2em;
		box-shadow: var(--box-shadow);
	}
	.pillars h3 {
		font-size: 1.1em;
		margin: 0 0 0.3em;
	}
	.pillars p {
		font-size: 0.85em;
		color: rgb(var(--gray));
		margin: 0 0 0.6em;
	}
	.pillars a {
		font-size: 0.8em;
	}
	@media (max-width: 720px) {
		.hero h1 {
			font-size: 1.9em;
		}
	}
</style>

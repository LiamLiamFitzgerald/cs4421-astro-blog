---
import Icon from '../components/Icon.astro';
import Layout from '../layouts/Layout.astro';
import '../styles/board.css';
---

<Layout title="Play" description="Play Catan on one device, or keep score of a game on a real board.">
	<div class="scoreboard">
		<p id="announcer" class="sr-only" aria-live="polite" aria-atomic="true"></p>

		<div class="toolbar">
			<h1>Catan</h1>
			<button id="new-game" class="button" type="button" hidden>
				<Icon name="plus" />
				New game
			</button>
		</div>

		<div id="storage-note" class="notice" hidden>
			<Icon name="info" />
			<div class="notice__body">
				<p>
					This browser is not letting the site save data, so the game will be lost if you reload or
					close the tab.
				</p>
			</div>
		</div>

		<div id="failure" class="notice notice--error" role="alert" hidden></div>

		<p id="loading" class="hint" role="status">Loading your saved game…</p>
		<noscript>
			<div class="notice notice--error">
				<div class="notice__body"><p>The scoreboard needs JavaScript. Turn it on and reload.</p></div>
			</div>
		</noscript>

		<!-- Setup: shown when there is no game in progress. -->
		<section id="setup" class="setup" aria-labelledby="setup-title" hidden>
			<figure class="setup__board">
				<svg id="setup-board" class="board" aria-label="The board for this game"></svg>
				<ol id="setup-board-list" class="sr-only" aria-label="Hexes on this board"></ol>
				<figcaption>
					<button id="deal" class="button button--small" type="button">
						<Icon name="dice" />
						Deal another board
					</button>
				</figcaption>
			</figure>

			<form id="setup-form" class="panel setup__form" novalidate>
				<fieldset class="modes">
					<legend>How do you want to play?</legend>
					<label class="mode">
						<input type="radio" name="mode" value="play" checked />
						<span class="mode__text">
							<span class="mode__name">Play on the site</span>
							<span class="hint">Place pieces, roll dice and collect resources, passing this device round.</span>
						</span>
					</label>
					<label class="mode">
						<input type="radio" name="mode" value="score" />
						<span class="mode__text">
							<span class="mode__name">Just keep score</span>
							<span class="hint">Play on a real board and record points here.</span>
						</span>
					</label>
				</fieldset>
				<h2 id="setup-title">Who is playing?</h2>
				<p class="hint">Enter 2 to 6 names in seating order. The first player goes first.</p>
				<ol id="player-fields" class="player-fields"></ol>
				<button id="add-player" class="button button--quiet button--small" type="button">
					<Icon name="plus" />
					Add a player
				</button>
				<p id="setup-error" class="field-error" role="alert" hidden></p>
				<button class="button button--primary setup__start" type="submit">Start game</button>
			</form>
		</section>

		<!-- Game: shown while a game is in progress or finished. -->
		<section id="game" class="game" aria-label="Game in progress" hidden>
			<div id="winner" class="notice notice--success" role="status" hidden>
				<Icon name="crown" />
				<div class="notice__body"></div>
			</div>

			<div class="game__layout">
				<figure class="game__board">
					<svg id="game-board" class="board" aria-label="This game's board"></svg>
					<ol id="game-board-list" class="sr-only" aria-label="Hexes on this board"></ol>
					<p id="no-board" class="hint no-board" hidden>
						This game was started before boards were dealt, so it has no board. Start a new game to
						get one.
					</p>
				</figure>

				<div class="game__side">
					<h2 class="sr-only">Players</h2>
					<div id="players" class="players stack"></div>
				</div>
			</div>

			<details class="history">
				<summary>
					Event log <span class="history__count">(<span id="event-count">0</span> events)</span>
				</summary>
				<p class="hint">
					Every action is stored as an event, newest first. Scores and awards are worked out from
					this list.
				</p>
				<ol id="events" reversed></ol>
			</details>
		</section>

		<!-- Play mode: a game played on the site (src/ui/play.ts). -->
		<section id="play" class="play" aria-label="Game in progress" hidden>
			<div id="play-winner" class="notice notice--success" role="status" hidden>
				<Icon name="crown" />
				<div class="notice__body"></div>
			</div>
			<div class="game__layout">
				<figure class="game__board">
					<svg id="play-board" class="board" aria-label="The board, with everyone's pieces"></svg>
					<ol id="play-board-list" class="sr-only" aria-label="Hexes on this board"></ol>
					<figcaption id="play-board-hint" class="hint board-hint" aria-live="polite"></figcaption>
				</figure>
				<div class="game__side">
					<section id="play-turn" class="panel turn" aria-labelledby="turn-title"></section>
					<h2 class="sr-only">Players</h2>
					<div id="play-players" class="players stack"></div>
				</div>
			</div>
			<details class="history">
				<summary>
					Event log <span class="history__count">(<span id="play-event-count">0</span> events)</span>
				</summary>
				<p class="hint">Every move is stored as an event, newest first. The game is rebuilt from this list.</p>
				<ol id="play-events" reversed></ol>
			</details>
		</section>

		<dialog id="confirm-new-game" class="dialog" aria-labelledby="confirm-title">
			<form method="dialog">
				<h2 id="confirm-title">Discard this game?</h2>
				<p>
					The scores and event log for <strong id="confirm-players"></strong> will be deleted. This
					cannot be undone.
				</p>
				<div class="dialog__actions">
					<button class="button" value="keep" autofocus>Keep playing</button>
					<button class="button button--danger" value="discard">Discard and start over</button>
				</div>
			</form>
		</dialog>
	</div>
</Layout>

<script>
	import { reportError } from '../ui/report-error';
	import { startScoreboard } from '../ui/scoreboard';

	// Unexpected failures go to the console and to the server log (/api/client-errors).
	startScoreboard(reportError);
</script>

<style is:global>
	/* Global because the panels are built by the script (see ADR-006); every
	   selector is namespaced under .scoreboard. */
	.scoreboard {
		display: grid;
		gap: var(--space-4);
	}
	/* A working screen: a compact heading, so the board gets the space. */
	.scoreboard h1 {
		margin: 0;
		font-size: var(--text-2xl);
	}
	.scoreboard .toolbar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-3);
	}
	.scoreboard .failure__details {
		margin-top: var(--space-2);
		font-size: var(--text-xs);
	}
	.scoreboard .failure__details code {
		display: block;
		margin-top: var(--space-1);
		white-space: pre-wrap;
		word-break: break-word;
	}

	/* Seat markers: number plus colour, so identity never relies on colour alone. */
	.seat {
		display: inline-grid;
		place-items: center;
		flex: none;
		width: 1.75rem;
		height: 1.75rem;
		border-radius: var(--radius-full);
		color: #fff; /* white numerals: every seat colour passes 4.5:1 */
		font-weight: 700;
		font-size: var(--text-s);
		background: var(--seat-colour, var(--color-ink-muted));
	}
	.seat--1, .seat-color--1 { --seat-colour: var(--seat-1); }
	.seat--2, .seat-color--2 { --seat-colour: var(--seat-2); }
	.seat--3, .seat-color--3 { --seat-colour: var(--seat-3); }
	.seat--4, .seat-color--4 { --seat-colour: var(--seat-4); }
	.seat--5, .seat-color--5 { --seat-colour: var(--seat-5); }
	.seat--6, .seat-color--6 { --seat-colour: var(--seat-6); }

	/* Setup */
	.scoreboard .setup {
		display: grid;
		grid-template-columns: minmax(0, 1.2fr) minmax(18rem, 1fr);
		gap: var(--space-6);
		align-items: start;
	}
	.scoreboard .setup__board {
		margin: 0;
		display: grid;
		gap: var(--space-3);
		justify-items: center;
	}
	.scoreboard .setup__board .board {
		max-width: 34rem;
	}
	.scoreboard .setup__form {
		display: grid;
		gap: var(--space-3);
		padding: var(--space-5);
	}
	.scoreboard .setup__form h2 {
		margin: 0;
		font-size: var(--text-xl);
	}
	.scoreboard .player-fields {
		display: grid;
		gap: var(--space-2);
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.scoreboard .player-field {
		display: flex;
		align-items: center;
		gap: var(--space-2);
	}
	.scoreboard .player-field .input {
		flex: 1;
		min-width: 0;
	}
	.scoreboard #add-player {
		justify-self: start;
	}
	.scoreboard .field-error {
		margin: 0;
		color: var(--color-danger);
		font-weight: 500;
		font-size: var(--text-s);
	}
	.scoreboard .setup__start {
		margin-top: var(--space-2);
	}

	/* Game */
	.scoreboard .game {
		display: grid;
		gap: var(--space-4);
	}
	.scoreboard .game__layout {
		display: grid;
		grid-template-columns: minmax(0, 1.25fr) minmax(20rem, 1fr);
		gap: var(--space-5);
		align-items: start;
	}
	.scoreboard .game__board {
		margin: 0;
		position: sticky;
		top: var(--space-4);
	}
	.scoreboard .no-board {
		padding: var(--space-6) var(--space-4);
		text-align: center;
		border: 1px dashed var(--color-line-strong);
		border-radius: var(--radius-m);
	}
	/* Players share one surface, separated by lines, with a seat-colour edge. */
	.scoreboard .players {
		display: grid;
	}
	.scoreboard .game__side {
		display: grid;
		gap: var(--space-4);
		align-content: start;
	}

	.scoreboard .player {
		display: grid;
		gap: var(--space-2);
		padding: var(--space-3) var(--space-4) var(--space-4) calc(var(--space-4) + 4px);
		box-shadow: inset 4px 0 0 var(--seat-colour);
	}
	.scoreboard .player--winner {
		background: var(--color-wheat-tint);
	}
	.scoreboard .player--changed {
		animation: player-changed var(--duration-medium) var(--ease-out) 2;
	}
	@keyframes player-changed {
		50% {
			background: var(--color-gold-tint);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.scoreboard .player--changed {
			animation: none;
		}
	}
	.scoreboard .player__head {
		display: flex;
		align-items: center;
		gap: var(--space-2);
	}
	.scoreboard .player__name {
		flex: 1;
		min-width: 0;
		margin: 0;
		font-size: var(--text-l);
		overflow-wrap: anywhere;
	}
	.scoreboard .player__score {
		margin: 0;
		color: var(--color-ink-muted);
		font-size: var(--text-s);
		white-space: nowrap;
	}
	.scoreboard .player__score strong {
		font-family: var(--font-heading);
		font-size: var(--text-2xl);
		line-height: 1;
		color: var(--color-ink);
	}
	.scoreboard .meter {
		display: grid;
		grid-template-columns: repeat(10, 1fr);
		gap: 3px;
	}
	.scoreboard .meter__step {
		height: 6px;
		border-radius: 2px;
		background: var(--color-surface-sunk);
	}
	.scoreboard .meter__step--on {
		background: var(--seat-colour);
	}
	.scoreboard .awards {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-1);
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.scoreboard .awards:empty {
		display: none;
	}
	.scoreboard .award {
		display: inline-flex;
		align-items: center;
		gap: var(--space-1);
		padding: 0.1rem var(--space-2);
		border-radius: var(--radius-full);
		font-size: var(--text-xs);
		font-weight: 500;
		background: var(--color-forest-tint);
		color: var(--color-forest);
	}
	.scoreboard .award--winner {
		background: var(--color-gold-tint);
		color: var(--color-ink);
	}
	.scoreboard .stats {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: var(--space-2);
		margin: 0;
		padding: var(--space-2) 0;
		border-block: 1px solid var(--color-line);
	}
	.scoreboard .stat {
		display: flex;
		flex-direction: column;
		align-items: center;
	}
	.scoreboard .stat__value {
		display: inline-flex;
		align-items: center;
		gap: var(--space-1);
		margin: 0;
		font-weight: 700;
		font-size: var(--text-l);
		line-height: 1.2;
	}
	.scoreboard .stat__value .icon {
		color: var(--color-ink-muted);
		stroke-width: 1.6;
	}
	.scoreboard .stat__label {
		font-size: var(--text-xs);
		color: var(--color-ink-muted);
	}
	.scoreboard .actions {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(6.5rem, 1fr));
		gap: var(--space-2);
	}
	.scoreboard .road {
		display: flex;
		align-items: center;
		gap: var(--space-2);
	}
	.scoreboard .road__label {
		display: inline-flex;
		align-items: center;
		gap: var(--space-1);
		margin-right: auto;
		font-size: var(--text-s);
		color: var(--color-ink-muted);
	}
	.scoreboard .road .button {
		width: 2rem;
		padding: 0;
		font-size: var(--text-l);
	}
	.scoreboard .road__value {
		min-width: 1.5rem;
		text-align: center;
		font-weight: 700;
	}
	.scoreboard .player__feedback {
		margin: 0;
		padding: var(--space-2) var(--space-3);
		border-radius: var(--radius-s);
		background: var(--color-danger-tint);
		color: var(--color-danger-strong);
		font-size: var(--text-s);
	}
	.scoreboard .player__feedback[hidden] {
		display: none;
	}

	.scoreboard .history {
		padding: var(--space-3) var(--space-4);
		border-top: 1px solid var(--color-line);
	}
	.scoreboard .history summary {
		cursor: pointer;
		font-weight: 500;
	}
	.scoreboard .history__count {
		color: var(--color-ink-muted);
		font-weight: 400;
	}
	.scoreboard .history .hint {
		margin: var(--space-2) 0;
	}
	.scoreboard .history ol {
		margin: 0;
		padding-left: var(--space-6);
		max-height: 16rem;
		overflow-y: auto;
		font-size: var(--text-s);
	}

	@media (max-width: 56rem) {
		.scoreboard .setup,
		.scoreboard .game__layout {
			grid-template-columns: 1fr;
			gap: var(--space-4);
		}
		.scoreboard .game__board {
			position: static;
		}
		.scoreboard .game__board .board,
		.scoreboard .setup__board .board {
			max-width: 26rem;
			margin: 0 auto;
		}
	}
	/* Mode choice */
	.scoreboard .modes {
		display: grid;
		gap: var(--space-2);
		margin: 0 0 var(--space-2);
		padding: 0;
		border: 0;
	}
	.scoreboard .modes legend {
		font-family: var(--font-heading);
		font-size: var(--text-xl);
		font-weight: 700;
		margin-bottom: var(--space-2);
	}
	.scoreboard .mode {
		display: flex;
		gap: var(--space-3);
		align-items: flex-start;
		padding: var(--space-3);
		border: 1px solid var(--color-line);
		border-radius: var(--radius-s);
		cursor: pointer;
		background: var(--color-surface-raised);
	}
	.scoreboard .mode:has(input:checked) {
		border-color: var(--color-forest);
		box-shadow: inset 0 0 0 1px var(--color-forest);
		background: var(--color-sage-tint);
	}
	.scoreboard .mode:has(input:focus-visible) {
		outline: 3px solid var(--color-focus);
		outline-offset: 2px;
	}
	.scoreboard .mode input {
		margin-top: 0.3rem;
		accent-color: var(--color-forest);
	}
	.scoreboard .mode__text {
		display: grid;
	}
	.scoreboard .mode__name {
		font-weight: 700;
	}

	/* Play mode */
	.scoreboard .board-hint {
		min-height: 1.5em;
		margin-top: var(--space-2);
		text-align: center;
		font-weight: 500;
		color: var(--color-forest);
	}
	.scoreboard .turn {
		display: grid;
		gap: var(--space-3);
		padding: var(--space-4);
		border-top: 3px solid var(--color-forest);
	}
	.scoreboard .turn__head {
		display: flex;
		align-items: center;
		gap: var(--space-2);
	}
	.scoreboard .turn__title {
		margin: 0;
		font-size: var(--text-xl);
		flex: 1;
	}
	.scoreboard .turn__phase {
		padding: 0.1rem var(--space-2);
		border-radius: var(--radius-full);
		background: var(--color-gold-tint);
		color: var(--color-ink);
		font-size: var(--text-xs);
		font-weight: 700;
	}
	.scoreboard .turn__step {
		margin: 0;
		font-weight: 500;
	}
	.scoreboard .turn__actions {
		display: grid;
		gap: var(--space-3);
	}
	.scoreboard .turn__end {
		justify-self: end;
	}
	.scoreboard .roll {
		display: flex;
		align-items: center;
		gap: var(--space-3);
		padding: var(--space-2) var(--space-3);
		border-radius: var(--radius-s);
		background: var(--color-surface-sunk);
	}
	.scoreboard .roll__dice {
		display: flex;
		gap: var(--space-1);
		flex: none;
	}
	.scoreboard .roll__text {
		margin: 0;
		font-size: var(--text-s);
	}
	.scoreboard .die {
		width: 2.4rem;
		height: 2.4rem;
	}
	.scoreboard .die__face {
		fill: var(--color-surface-raised);
		stroke: var(--color-line-strong);
		stroke-width: 2;
	}
	.scoreboard .die__pip {
		fill: var(--color-ink);
	}
	.scoreboard .roll--new .die {
		animation: die-roll 420ms var(--ease-out);
	}
	@keyframes die-roll {
		0% {
			transform: rotate(-25deg) scale(0.8);
		}
		60% {
			transform: rotate(12deg) scale(1.05);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.scoreboard .roll--new .die {
			animation: none;
		}
	}
	.scoreboard .builds {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: var(--space-2);
	}
	.scoreboard .build {
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-1);
		height: auto;
		padding: var(--space-2) var(--space-3);
		text-align: left;
		line-height: 1.25;
	}
	.scoreboard .build[aria-pressed='true'] {
		background: var(--color-forest);
		border-color: var(--color-forest-strong);
		color: var(--color-ink-inverse);
	}
	.scoreboard .build__label {
		display: inline-flex;
		align-items: center;
		gap: var(--space-1);
		font-weight: 700;
	}
	.scoreboard .build .cost {
		display: inline-flex;
		gap: 1px;
	}
	.scoreboard .build .cost .icon {
		width: 1rem;
		height: 1rem;
	}
	.scoreboard .build__note {
		font-size: var(--text-xs);
		opacity: 0.85;
	}
	.scoreboard .trade {
		display: grid;
		gap: var(--space-2);
		padding-top: var(--space-3);
		border-top: 1px solid var(--color-line);
	}
	.scoreboard .trade__title {
		margin: 0;
		font-weight: 500;
		font-size: var(--text-s);
	}
	.scoreboard .trade__row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-2);
	}
	.scoreboard .trade__select {
		min-height: 2rem;
		padding: var(--space-1) var(--space-2);
		font-size: var(--text-s);
	}
	.scoreboard .trade__for {
		color: var(--color-ink-muted);
		font-size: var(--text-s);
	}
	.scoreboard .play-player {
		display: grid;
		gap: var(--space-2);
		padding: var(--space-3) var(--space-4) var(--space-3) calc(var(--space-4) + 4px);
		box-shadow: inset 4px 0 0 var(--seat-colour);
		transition: background-color var(--duration-medium) var(--ease-out);
	}
	/* The player whose turn it is sits on sage, the colour for "this one". */
	.scoreboard .play-player--current {
		background: var(--color-sage-tint);
	}
	.scoreboard .hand {
		display: grid;
		grid-template-columns: repeat(5, minmax(0, 1fr));
		gap: var(--space-1);
		margin: 0;
		text-align: center;
	}
	.scoreboard .hand__item {
		display: grid;
		justify-items: center;
		padding: var(--space-1) 0;
		border-radius: var(--radius-s);
	}
	.scoreboard .hand__item--none {
		color: var(--color-ink-disabled);
	}
	.scoreboard .hand__item--none .hand__count {
		font-weight: 400;
	}
	/* Resources just received: a brief wheat glow and a +n badge. */
	.scoreboard .hand__item--gain {
		animation: hand-gain 900ms var(--ease-out);
	}
	@keyframes hand-gain {
		from {
			background: var(--color-wheat-tint);
		}
	}

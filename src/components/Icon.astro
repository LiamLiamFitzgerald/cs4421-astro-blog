---
import { ICONS, type IconName } from '../ui/icons';

interface Props {
	name: IconName;
	/** Give a label only when the icon carries meaning on its own. */
	label?: string;
	class?: string;
}

const { name, label, class: className } = Astro.props;
---

<svg
	viewBox="0 0 24 24"
	class:list={['icon', `icon--${name}`, className]}
	role={label ? 'img' : undefined}
	aria-label={label}
	aria-hidden={label ? undefined : 'true'}
>
	{ICONS[name].map((d) => <path d={d} />)}
</svg>

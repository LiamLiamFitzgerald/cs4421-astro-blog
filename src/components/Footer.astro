---
import { AUTHOR, REPO_URL } from '../consts';
import Icon from './Icon.astro';
---

<footer class="site-footer">
	<div class="site-footer__inner">
		<p>Built by {AUTHOR} for CS4421 DevOps at the University of Limerick.</p>
		<a href={REPO_URL} class="site-footer__link">
			<Icon name="code" />
			Source code on GitHub
		</a>
	</div>
</footer>

<style>
	.site-footer {
		border-top: 1px solid var(--color-line);
		background: var(--color-surface-sunk);
		color: var(--color-ink-muted);
		font-size: var(--text-s);
	}
	.site-footer__inner {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: center;
		gap: var(--space-2) var(--space-5);
		max-width: var(--content-width);
		margin: 0 auto;
		padding: var(--space-4);
	}
	.site-footer p {
		margin: 0;
	}
	.site-footer__link {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		color: var(--color-ink-muted);
	}
</style>

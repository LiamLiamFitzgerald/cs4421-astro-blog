---
import { NAV, SITE_TITLE } from '../consts';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header">
	<nav class="site-header__inner" aria-label="Main">
		<a class="wordmark" href="/">
			<svg viewBox="0 0 32 32" aria-hidden="true" class="wordmark__mark">
				<path d="M16 2 28.1 9v14L16 30 3.9 23V9Z" />
				<path d="M16 9.5 21.6 12.7v6.6L16 22.5l-5.6-3.2v-6.6Z" class="wordmark__inner" />
			</svg>
			<span>{SITE_TITLE}</span>
		</a>
		<ul class="site-nav">
			{
				NAV.map((item) => (
					<li>
						<a href={item.href} aria-current={path === item.href ? 'page' : undefined}>
							{item.label}
						</a>
					</li>
				))
			}
		</ul>
	</nav>
</header>

<style>
	.skip-link {
		position: absolute;
		left: var(--space-3);
		top: -4rem;
		z-index: 10;
		padding: var(--space-2) var(--space-3);
		background: var(--color-surface);
		color: var(--color-ink);
		border-radius: var(--radius-s);
	}
	.skip-link:focus {
		top: var(--space-3);
	}
	.site-header {
		background: var(--color-forest);
		color: var(--color-ink-inverse);
		border-bottom: 3px solid var(--color-forest-strong);
	}
	.site-header__inner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-2) var(--space-5);
		max-width: var(--content-width);
		margin: 0 auto;
		padding: var(--space-3) var(--space-4);
	}
	.wordmark {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		color: var(--color-ink-inverse);
		font-family: var(--font-heading);
		font-size: var(--text-l);
		font-weight: 700;
		text-decoration: none;
	}
	.wordmark:hover {
		color: var(--color-ink-inverse);
	}
	.wordmark__mark {
		width: 1.6rem;
		height: 1.6rem;
		fill: var(--color-ink-inverse);
	}
	.wordmark__inner {
		fill: var(--terrain-fields);
	}
	.site-nav {
		display: flex;
		gap: var(--space-1);
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.site-nav a {
		display: block;
		padding: var(--space-1) var(--space-3);
		border-radius: var(--radius-s);
		color: var(--color-ink-inverse);
		text-decoration: none;
		font-weight: 500;
	}
	.site-nav a:hover {
		background: rgb(246 240 223 / 0.12);
		color: var(--color-ink-inverse);
	}
	.site-nav a[aria-current='page'] {
		background: rgb(246 240 223 / 0.16);
		box-shadow: inset 0 -2px 0 var(--terrain-fields);
	}
	.site-header :focus-visible {
		outline-color: var(--terrain-fields);
	}
</style>
